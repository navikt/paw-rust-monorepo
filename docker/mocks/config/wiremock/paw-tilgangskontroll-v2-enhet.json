{
    "priority": 1,
    "request": {
        "method": "POST",
        "urlPathPattern": "/api/v1/tilgang/enhet",
        "bodyPatterns": [
            {
                "matchesJsonPath": {
                    "expression": "$.navIdent",
                    "matches": "^(Z123456)$"
                }
            },
            {
                "matchesJsonPath": {
                    "expression": "$.identitetsnummer",
                    "matches": "^(01017012345|03017012345)$"
                }
            }
        ]
    },
    "response": {
        "status": 200,
        "jsonBody": {
            "harTilgang": true
        },
        "headers": {
            "Content-Type": "application/json"
        }
    }
}